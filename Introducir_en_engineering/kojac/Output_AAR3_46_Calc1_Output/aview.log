! Found 3 Variable entities matching "*": .universal_joint.cre_ass.file_name, .universal_joint.cre_ass.exists, 
! .universal_joint.cre_ass.joint_type
! >> var del var=.universal_joint.cre_ass.*
! >> view manage orient view = top
! >> !
! >> ! *** %W% %G%
! >> !
! >> !
! >> !USER_ENTERED_COMMAND view management orient
! >> !WRAP_IN_UNDO NO
! >> !CREATE_PANEL NO
! >> !
! >> !   Top
! >> !   Y_pos
! >> !   Z_pos
! >> !
! >> !   Here is how I figured out the front view for any axis combination:
! >> !    X up =  90 * Z
! >> !       Z out =   0 * Y
! >> !       Y out =  90 * Y
! >> !      -Z out = 180 * Y
! >> !      -Y out = 270 * Y
! >> !   -X up = -90 * Z
! >> !       Z out =   0 * Y
! >> !      -Y out =  90 * Y
! >> !      -Z out = 180 * Y
! >> !       Y out = 270 * Y
! >> !    Y up =   0 * Z
! >> !       Z out =   0 * Y
! >> !      -X out =  90 * Y
! >> !      -Z out = 180 * Y
! >> !       X out = 270 * Y
! >> !   -Y up = 180 * Z
! >> !       Z out =   0 * Y
! >> !       X out =  90 * Y
! >> !      -Z out = 180 * Y
! >> !      -X out = 270 * Y
! >> !    Z up =  90 * X + 180 * Z
! >> !       Y out =   0 * Y
! >> !       X out =  90 * Y
! >> !      -Y out = 180 * Y
! >> !      -X out = 270 * Y
! >> !   -Z up =  90 * X
! >> !       Y out =   0 * Y
! >> !      -X out =  90 * Y
! >> !      -Y out = 180 * Y
! >> !       X out = 270 * Y
! >> !
! >> interface model_browser set auto_refresh = off
! >> !
! >> if c=(str_substr("Y_pos", 1, 1) == str_substr("Z_pos", 1, 1))
! -1>>    var set var=.MDI.view_management_orient.xalert &
! -1&>       int=(eval(alert("error", "You must have different axes for UP and FORWARD.", "OK", "", "", 1)))
! -1>>    return
! -1>> end
! >> !
! >> ! Create the screen basis vectors
! >> var set var=.MDI.view_management_orient.X_s rea=({1,0,0})
! >> var set var=.MDI.view_management_orient.Y_s rea=({0,1,0})
! >> var set var=.MDI.view_management_orient.Z_s rea=({0,0,1})
! >> !
! >> var set var=.MDI.view_management_orient.sign_f int=(str_substr("Z_pos", 3, 3) == "neg")
! >> var set var=.MDI.view_management_orient.fwd    str=(str_substr("Z_pos", 1, 1))
! >> !
! >> ! Put the view into its front orientation, according to the up and forward
! >> ! axes specifications.
! >> if     c=("Y_pos" == "x_pos")
! -1>>    view manage modify &
! -1&>       obj=( 90d * .MDI.view_management_orient.Z_s + ((.MDI.view_management_orient.fwd == "Y" ? -90d : 0) + .MDI.view_management_orient.sign_f * 180d) * .MDI.view_management_orient.Y_s)
! -1>> elseif c=("Y_pos" == "x_neg")
! -1>>    view manage modify &
! -1&>       obj=(-90d * .MDI.view_management_orient.Z_s + ((.MDI.view_management_orient.fwd == "Y" ?  90d : 0) + .MDI.view_management_orient.sign_f * 180d) * .MDI.view_management_orient.Y_s)
! -1>> elseif c=("Y_pos" == "y_pos")
! +1>>    view manage modify &
! +1&>       obj=(  0 * .MDI.view_management_orient.Z_s + ((.MDI.view_management_orient.fwd == "X" ? -90d : 0) + .MDI.view_management_orient.sign_f * 180d) * .MDI.view_management_orient.Y_s)
! -1>> elseif c=("Y_pos" == "y_neg")
! -1>>    view manage modify &
! -1&>       obj=(180d * .MDI.view_management_orient.Z_s + ((.MDI.view_management_orient.fwd == "X" ?  90d : 0) + .MDI.view_management_orient.sign_f * 180d) * .MDI.view_management_orient.Y_s)
! -1>> elseif c=("Y_pos" == "z_pos")
! -1>>    view manage modify &
! -1&>       obj=( 90d * .MDI.view_management_orient.X_s + 180d * .MDI.view_management_orient.Z_s + ((.MDI.view_management_orient.fwd == "X" ? -90d : 0) + .MDI.view_management_orient.sign_f * 180d) * .MDI.view_management_orient.Y_s)
! -1>> elseif c=("Y_pos" == "z_neg")
! -1>>    view manage modify &
! -1&>       obj=( 90d * .MDI.view_management_orient.X_s + ((.MDI.view_management_orient.fwd == "X" ?  90d : 0) + .MDI.view_management_orient.sign_f * 180d) * .MDI.view_management_orient.Y_s)
! -1>> end
! >> !
! >> ! Now spin things around from the front to the requested orientation.
! >> if     c=("Top" == "back")
! -1>>    view rotate screen=(eval(180d * .MDI.view_management_orient.Y_s))
! -1>> elseif c=("Top" == "bottom")
! -1>>    view rotate screen=(eval(-90d * .MDI.view_management_orient.X_s))
! -1>> elseif c=("Top" == "iso")
! -1>>    view rotate screen=(eval({45d,-35d,-30d}))
! -1>> elseif c=("Top" == "plot3d")
! -1>>    view rotate screen=(eval({9.5d,-18.2d, -3d}))
! -1>> elseif c=("Top" == "left")
! -1>>    view rotate screen=(eval( 90d * .MDI.view_management_orient.Y_s))
! -1>> elseif c=("Top" == "right")
! -1>>    view rotate screen=(eval(-90d * .MDI.view_management_orient.Y_s))
! -1>> elseif c=("Top" == "top")
! +1>>    view rotate screen=(eval( 90d * .MDI.view_management_orient.X_s))
! +1>> end
