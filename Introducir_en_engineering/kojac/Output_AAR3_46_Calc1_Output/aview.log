! -2>> !
! -2>>   elseif condition=(.universal_joint.cre_ass.joint_type.string_value == "aar")
! +2>>       !  Read Test Rig
! +2>>       !
! +2>>       cv_assembly singlejoint
! +2>> !==================================================================
! +2>> !
! +2>> !--                                            Testrig Single Joint
! +2>> !
! +2>> !==================================================================
! +2>> !
! +2>> ! Modifications:
! +2>> !
! +2>> ! lscho 2006-11-21 - added dummy1.dummy2_ir to be used as reference
! +2>> !   marker for inner race Angle Rotation request.
