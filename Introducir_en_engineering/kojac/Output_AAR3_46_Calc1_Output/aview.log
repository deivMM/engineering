! +2>> !
! +2>> model create model="CV_Joint" &
! +2&>       comments=""
! +2>> !
! +2>> force create body gravitational gravity_field_name=.cv_Joint.ACC1 &
! +2&>  x_component_gravity=0 &
! +2&>  y_component_gravity=-9810 &
! +2&>  z_component_gravity=0
! +2>> !
