! -2&>        object = .CV_Joint.ground.MARKER_1 &
! -2&>       comments = ""
! -2>>       !
! -2>>       variable modify variable_name=.CV_Joint.do.cv_mar_ref_inner_race &
! -2&>       object= .CV_Joint.ground.MARKER_1 &
! -2&>       comments = ""
! -2>>       !
