! -2&>        testrig = .CV_Joint &
! -2&>        instance_name = .CV_Joint.do
! -2>> !
! -2>>       ! execute python script to check for 3D geometry 
! -2>>       cv_joint utility modify_do_3d 
! -2>> !
! -2>>   elseif condition=(.universal_joint.cre_ass.joint_type.string_value == "gi")
! -2>> !
! -2>>       !==================================================================
