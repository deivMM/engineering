! +2>> !
! +2>> marker modify marker_name=.CV_Joint.ground.ground_homokin &
! +2&>   location= (loc_relative_to({0,(-sin(.CV_Joint.articulation_angle/2)*50), (cos(.CV_Joint.articulation_angle/2)*50)}, .CV_Joint.ground.Joint_Reference)) &
! +2&>   orientation= (ori_relative_to({0d,(.CV_Joint.articulation_angle/2)d,0d}, .CV_Joint.ground.Joint_Reference))
! +2>> !
! +2>> !marker modify marker_name=.CV_Joint.ground.ground_homokin1 &
! +2>> !  location= (loc_relative_to({0,(-sin(.CV_Joint.articulation_angle/2)*50), (cos(.CV_Joint.articulation_angle/2)*50)}, .CV_Joint.ground.Joint_Reference)) &
! +2>> !  orientation= (ori_relative_to({0d,(.CV_Joint.articulation_angle/2-90)d,0d}, .CV_Joint.ground.Joint_Reference))
! +2>> !
! +2>> !marker modify marker_name=.CV_Joint.ground.ground_homokin2 &
! +2>> !  location= (loc_relative_to({0,(-sin(.CV_Joint.articulation_angle/2)*50),(cos(.CV_Joint.articulation_angle/2)*50)}, .CV_Joint.ground.Joint_Reference)) &
! +2>> !  orientation= (ori_relative_to({90d, -90d, 0d}, .CV_Joint.ground.ground_homokin1))
! +2>> !
! +2>> !
! +2>> !==================================================================
! +2>> !-- J Marker of Revolute Joint OR_rev
! +2>> !
! +2>> marker create  &
! +2&>    marker_name = .CV_Joint.ground.orjj  &
! +2&>    location = (loc_relative_to({0, 0, 0},.CV_Joint.ground.Joint_Reference))  &
! +2&>    orientation = (ori_relative_to({0d, 0d, 0d},.CV_Joint.ground.Joint_Reference))
! +2>> !
! +2>> !-- J Marker of Articulation Joint dummy1_rev
! +2>> !
! +2>> marker create  &
! +2&>    marker_name = .CV_Joint.ground.ground_rev  &
! +2&>    location = (loc_relative_to({0.0, 0.0, 0.0} ,.CV_Joint.ground.Joint_Reference))   &
! +2&>    orientation = (ori_relative_to({-90.0d, -90.0d, 0.0d} ,.CV_Joint.ground.Joint_Reference))
! +2>> !
! +2>> marker create  &
! +2&>    marker_name = .CV_Joint.ground.cjj  &
! +2&>    location = 0.0, 0.0, 0.0  &
! +2&>    orientation = 0d, 0d, 0d
! +2>> !
! +2>> !==================================================================
! +2>> !-- DUMMY1 part for articulation motion
! +2>> !
! +2>> part create rigid_body name_and_position  &
! +2&>    part_name = .CV_Joint.dummy1  &
! +2&>    location = 0.0, 0, 0.0  &
! +2&>    orientation = 0.0d, 0.0d, 0.0d
! +2>> !
! +2>> !-- I-Marker of Revolute Joint dummy1_rev
! +2>> !
! +2>> marker create  &
! +2&>    marker_name = .CV_Joint.dummy1.dummy1_rev  &
! +2&>    location = (loc_relative_to({0.0, 0.0, 0.0} ,.CV_Joint.ground.Joint_Reference)) &
! +2&>    orientation = (ori_relative_to({-90.0d, -90.0d, 0.0d} ,.CV_Joint.ground.Joint_Reference))
! +2>> !
! +2>> !-- I-Marker of Inline Joint dummy1_ir
! +2>> !
! +2>> marker create  &
! +2&>    marker_name = .CV_Joint.dummy1.dummy1_ir  &
! +2&>   location = 0,0,0 &
! +2&>   orientation = 0,0,0 
! +2>> !
! +2>> marker create  &
! +2&>    marker_name = .CV_Joint.dummy1.dummy2_ir  &
! +2&>   location = 0,0,0 &
! +2&>   orientation = 0,0,0 
! +2>> !
! +2>> !
! +2>> !==================================================================
! +2>> !-- shaft end
! +2>> part create rigid_body name_and_position part_name=.CV_Joint.shaft_2 
! +2>> part attributes part_name=.CV_Joint.shaft_2 color=RED name_vis=off
! +2>> marker create marker=.CV_Joint.shaft_2.cyl_geo1 &
! +2&>     location=0.0, 0.0, (-.CV_Joint.cv_ishaft) &
! +2&>     orientation=0.0d, 180.0d, 0.0d
! +2>> geometry create shape cylinder &
! +2&>     cylinder_name=.CV_Joint.shaft_2.CYL_shaft &
! +2&>     length=(-60.0mm) &
! +2&>     radius=(5.0mm) &
! +2&>     angle=360.0d &
! +2&>     center_marker=.CV_Joint.shaft_2.cyl_geo1
! +2>> !
! +2>> marker modify marker=.CV_Joint.shaft_2.cyl_geo1 &
! +2&>     location=(loc_relative_to({0.0, 0.0, (.CV_Joint.cv_ishaft)}, .CV_Joint.ground.Joint_Reference)) &
! +2&>     orientation=(ori_relative_to({0.0d, 180.0d, 0.0d},.CV_Joint.ground.Joint_Reference)) 
! +2>> !
! +2>> marker create marker=.CV_Joint.shaft_2.joi_cyl_i &
! +2&>     location=(loc_relative_to({0.0, 0.0, (.CV_Joint.cv_ishaft)}, .CV_Joint.ground.Joint_Reference)) &
! +2&>     orientation=(ori_relative_to({0.0d, 180.0d, 0.0d},.CV_Joint.ground.Joint_Reference)) 
! +2>> marker create marker=.CV_Joint.dummy1.joi_cyl_i &
! +2&>     location=(loc_relative_to({0.0, 0.0, (.CV_Joint.cv_ishaft)}, .CV_Joint.ground.Joint_Reference)) &
! +2&>     orientation=(ori_relative_to({0.0d, 180.0d, 0.0d},.CV_Joint.ground.Joint_Reference)) 
! +2>> !
! +2>> constraint create joint Cylindrical &
! +2&>     joint_name=.CV_Joint.JOINT_1 &
! +2&>     i_marker_name=.CV_Joint.shaft_2.joi_cyl_i &
! +2&>     j_marker_name=.CV_Joint.dummy1.joi_cyl_i 
! +2>> constraint attribute constraint_name=.CV_Joint.JOINT_1 name_vis=off
! +2>> !
! +2>> marker create marker=.CV_Joint.shaft_2.convel_i &
! +2&>     location=(loc_relative_to({0.0, 0.0, (.CV_Joint.cv_ishaft)}, .CV_Joint.ground.Joint_Reference)) &
! +2&>     orientation=(ori_relative_to({0.0d, 0.0d, 0.0d},.CV_Joint.ground.Joint_Reference)) 
! +2>> !
! +2>> !==================================================================
! +2>> !-- External Load
! +2>> !
! +2>> ! the I & R marker name must be modified, that the torque is applied to the shaft of the
! +2>> ! inner race. The I & R -Marker Name must be : .cv_Joint.inner_race.ir_torque
! +2>> !
! +2>> !
! +2>> !-- load on inner race
! +2>> !
! +2>> floating_marker create  &
! +2&>    floating_marker_name = .CV_Joint.ground.FMARKER_Vto1 
! +2>> !
! +2>>   force create direct general_force  &
! +2&>    general_force_name = .cv_Joint.VTO1  &
! +2&>    i_marker_name = .CV_Joint.dummy1.dummy1_ir  &
! +2&>    ref_marker_name = .CV_Joint.dummy1.dummy1_ir  &
! +2&>    j_floating_marker_name = CV_Joint.ground.FMARKER_Vto1  &
! +2&>    x_force_function = "0"  &
! +2&>    y_force_function = "0"  &
! +2&>    z_force_function = "0"  &
! +2&>    x_torque_function = "0"  &
! +2&>    y_torque_function = "0"  &
! +2&>    z_torque_function = "0"
! +2>> !
! +2>> !-- load on outer race
! +2>> !
! +2>> floating_marker create  &
! +2&>    floating_marker_name = .CV_Joint.ground.FMARKER_Vto2 
! +2>> !
! +2>>   force create direct general_force  &
! +2&>    general_force_name = .cv_Joint.VTO2  &
! +2&>    i_marker_name = .CV_Joint.dummy1.dummy1_ir  &
! +2&>    ref_marker_name = .CV_Joint.dummy1.dummy1_ir  &
! +2&>    j_floating_marker_name = CV_Joint.ground.FMARKER_Vto2  &
! +2&>    x_force_function = "0"  &
! +2&>    y_force_function = "0"  &
! +2&>    z_force_function = "0"  &
! +2&>    x_torque_function = "0"  &
! +2&>    y_torque_function = "0"  &
! +2&>    z_torque_function = "0"
! +2>> !
! +2>> !
! +2>> !==================================================================
! +2>>    default model model=.CV_Joint
! +2>>    model display fit_to_view=yes
! +2>> !==================================================================
! +2>>       !
! +2>>       !==================================================================
! +2>>       !
! +2>>       !   
! +2>>       cv_joint aar read model_file="016cccc.mod" instance_name=aar
! +2>> !
! +2>> !***********************************************************
! +2>> !
! +2>> ! ADAMS/Tripod-CV-Joint
! +2>> !
! +2>> ! Description: This macro reads the model parameter from a file in TIEMORBIT
! +2>> !              format. This file has the extension ".mod".
! +2>> ! 
! +2>> !
! +2>> !***********************************************************
! +2>> !
! +2>> !
! +2>> !"016cccc.mod"
! +2>> !.CV_Joint.aar
! +2>> !
! +2>> !END_OF_PARAMETERS
! +2>> !
! +2>> undo begin_block suppress=yes
! +2>> !
! +2>> if condition=(!db_exists(".CV_Joint.aar"))
! +3>> !
! +3>> ude create instance &
! +3&>   instance_name = .CV_Joint.aar  &
! +3&>   definition_name = .universal_joint.AAR_Joint  &
! +3&>   orientation = 0,0,0
! +3>> end
! +2>> !
! +2>> cv_joint  aar read_modify &
! +2&>   instance_name=.CV_Joint.aar &
! +2&>   model_file="016cccc.mod"
! +2>> !***********************************************************
! +2>> !
! +2>> ! ADAMS/Tripod-CV-Joint
! +2>> !
! +2>> ! Description: This macro reads the model parameter from a file in TIEMORBIT
! +2>> !              format. This file has the extension ".mod".
! +2>> !
! +2>> !
! +2>> ! Modifications:
! +2>> !
! +2>> ! 2015/12/04 - Achim Lenz, changed roller geometry definition
! +2>> !                          gauge_width_f (RO_GaugeWidth_F) and 
! +2>> !                          gauge_diameter_e (RO_GaugeDiameter_E) removed.
! +2>> !                          These values were used to calculate roller outer diameter.
! +2>> !                          outer roller_outer_diameter_v1 -> RO_ORollerOD_V1.
! +2>> !                          inner roller_inner_diameter_re added (RO_IRollerID_RE)
! +2>> !
! +2>> !                          trunnion_barrel_radius_re  (SP_TrunnionBarrelRadius_RE) -> trunnion_radius_re (SP_TrunnionRadius_RE)
! +2>> !                          added trunnion_radius_re2 (SP_TrunnionBarrelRadius_RE2) (for later usage)
! +2>> !
! +2>> ! 2016/10   - Achim Lenz,  support for reduced mod-file, if 3D CAD geometry is used with ADAMS 3D Contact
! +2>> !                          default values for plunge length and outer roller outer diameter are used to position tripod in center of tulip
! +2>> ! 2016/11   - Achim Lenz   added Parameter "RO_RadialClearance" (radial clearance between inner / outer roller)
! +2>> ! 2016/12   - Achim Lenz   removed necessity of RO_ORollerID_V2 and RO_IRollerOD_V3 in case of CAD part. 
! +2>> ! 2017/01   - Achim Lenz   new requests Force_IRollerN_ORoller_Joint and Force_ORollerN_IRoller_Joint deactivated in case of needle bearings
! +2>> ! 2017/02   - Achim Lenz   RO_IRollerWidth_Q always required (for contact inner roller - circlip)
! +2>> ! 2019/03   - Achim Lenz   added variables SpringStiff_z and SpringPreDisp_z to mod-file joint configuration
! +2>> ! 2019/03   - Achim Lenz   if block CIRCLIP does not exist, then circlip is omitted and forces are deactivated
! +2>> ! 2020/08   - Achim Lenz   set Variable Ratio_Fri_IROR_TrIR = 1.0, if needles in model
! +2>> ! 2021/11   - Achim Lenz   Parameter "CI_ID" added to circlip. If not defined, then = 0
! +2>> !                          If CI_ID > RO_IRollerOD_V3, then contact forces between IRoller and Circlip are zero.
! +2>> !                          If CI_ID > RO_ORollerID_V2, then contact force between needle and circlip are deactivated.
! +2>> ! 2022/08   - Achim Lenz   Added reading of variable SpringDamp_z
! +2>> ! 2022/08   - Achim Lenz   added RO_AxInnerDist_IRoller_Top, RO_AxInnerDist_IRoller_Bot, NE_AxInnerDist_Needle_Top, NE_AxInnerDist_Needle_Bot
! +2>> !                                Block: ROLLER                                           Block: NEEDLE
! +2>> ! 2022/08   - Achim Lenz   Parameter CI_ID and logic from 2021/11 commented out
! +2>> ! 2022/08   - Achim Lenz   Added parameter RO_Contact_IR_OR_Ax3D
! +2>> ! 2022/10   - Achim Lenz   Added parameter RO_Contact_IR_Tulip
! +2>> ! 2022/10   - Achim Lenz   Changed mass approx for oroller and iroller for analytical models
! +2>> ! 2022-11   - Achim Lenz   Default value for tr_sp_loc = 0.5 * tu_len
! +2>> !
! +2>> ! 2022/11   - Achim Lenz   removed variable RO_Contact_IR_OR_Ax3D in mod file
! +2>> !                          contact is build depending on presence of RO_CirclipOuterDistance_S
! +2>> !
! +2>> !***********************************************************
! +2>> !
! +2>> !
! +2>> !"016cccc.mod"
! +2>> !.CV_Joint.aar
! +2>> !
! +2>> !END_OF_PARAMETERS
! +2>> !
! +2>> undo begin_block suppress=yes
! +2>> !
! +2>> variable set var=.universal_joint.error int=0
! +2>> variable set var=.universal_joint.error_msg string=""
! +2>> !
! +2>> ! check, if file exists and id of correct type
! +2>> !
! +2>> variable set variable_name=.universal_joint.AAR_read_modify.file_name  string=(eval("016cccc.mod"))
! +2>> !
! +2>> var set var=.universal_joint.AAR_read_modify.exists &
! +2&>   integer_value = (eval(file_exists(.universal_joint.AAR_read_modify.file_name)))
! +2>> !
! +2>> if condition=(.universal_joint.AAR_read_modify.exists != 1)
! -3>>     variable set variable=.universal_joint.AAR_read_modify.msg &
! -3&>       string=(eval(.universal_joint.AAR_read_modify.file_name//" does not exist.  Please check file name and try again."))
! -3>>     cv_joint utility errmsg &
! -3&>       type="error"  &
! -3&>       button1="Cancel Reading Model File"  &
! -3&>       msg=(eval(.universal_joint.AAR_read_modify.msg))
! -3>>       var del var = .universal_joint.AAR_read_modify.*
! -3>>       model delete model=(eval(.CV_Joint.aar.parent))
! -3>>       return
! -3>> end
! +2>> !
! +2>> variable set variable_name=.CV_Joint.aar.property_file &
! +2&>   string_value="016cccc.mod"
! +2>> !
! +2>> variable set variable_name=.universal_joint.AAR_read_modify.read &
! +2&>   integer=(eval(read_t_o_open_file(.universal_joint.AAR_read_modify.file_name)))
! +2>> !
! +2>> variable set variable_name=.universal_joint.AAR_read_modify.cv_Type &
! +2&>   string_value=(eval(read_t_o_string("JOINT_CONFIGURATION","JOINT_TYPE")))
! +2>> !
! +2>> variable set variable_name=.CV_Joint.aar.cv_FileVersion &
! +2&>   real_value=(eval(read_t_o_real("JOINT_CONFIGURATION","FileVersion")))
! +2>> !
! +2>> variable set variable_name=.CV_Joint.aar.cv_Joint_Descr &
! +2&>   string_value=(eval(read_t_o_string("JOINT_CONFIGURATION","Joint_Description")))
! +2>> !
! +2>> if cond=(read_t_o_attribute_exists("016cccc.mod","JOINT_CONFIGURATION","","SpringStiff_z"))
! -3>>     variable set variable_name=.CV_Joint.aar.SpringStiff_z &
! -3&>       real_value=(eval(read_t_o_real("JOINT_CONFIGURATION","SpringStiff_z")))
! -3>> end   
! +2>> if cond=(read_t_o_attribute_exists("016cccc.mod","JOINT_CONFIGURATION","","SpringDamp_z"))
! -3>>     variable set variable_name=.CV_Joint.aar.SpringDamp_z &
! -3&>       real_value=(eval(read_t_o_real("JOINT_CONFIGURATION","SpringDamp_z")))
! -3>> end   
! +2>> if cond=(read_t_o_attribute_exists("016cccc.mod","JOINT_CONFIGURATION","","SpringPreDisp_z"))
! -3>>     variable set variable_name=.CV_Joint.aar.SpringPreDisp_z &
! -3&>       real_value=(eval(read_t_o_real("JOINT_CONFIGURATION","SpringPreDisp_z")))
! -3>> end   
! +2>> if condition=((.universal_joint.AAR_read_modify.cv_Type) == "AAR_Joint")
! +3>>     variable set variable_name=.CV_Joint.aar.cv_jt  real=1.0
! +3>> else
! -3>>     variable set variable_name=.CV_Joint.aar.cv_jt  real=999
