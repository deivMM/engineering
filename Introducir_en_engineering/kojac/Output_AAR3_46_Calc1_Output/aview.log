! +2&>    string_value = ""
! +2>> !
! +2>> variable create  &
! +2&>    variable_name = .cv_Joint.dir  &
! +2&>    string_value = "" 
! +2>>   
! +2>> default coordinate_system default_coordinate_system=.CV_Joint
! +2>> !
! +2>> !-- The joint referance marker
! +2>> !
! +2>> marker create marker=.CV_Joint.ground.Joint_Reference &
! +2&>   location = 0.0, 0.0, 0.0 &
! +2&>  orientation= 0.0, 0.0, 0.0
! +2>>  
! +2>> disp icon mar mar=.CV_Joint.ground.Joint_Reference size=80
! +2>> !
! +2>> !-- Shadow marker of Joint_Reference, 
! +2>> !-- the joint is placed in respect to of marker_1
! +2>> !
! +2>> marker create marker=.CV_Joint.ground.MARKER_1 &
! +2&>   location = (loc_relative_to({0,0,0},.CV_Joint.ground.Joint_Reference)) &
! +2&>   orientation= (ori_relative_to({90d,-90d,0d},.CV_Joint.ground.Joint_Reference))
! +2>> !
! +2>> disp vis mar mar=.CV_Joint.ground.MARKER_1 vis=off
! +2>> !
! +2>> marker create  &
! +2&>    marker_name = .CV_Joint.ground.ground_homokin  &
! +2&>    location = 0,0,0 &
! +2&>    orientation = 0,0,0
! +2>> !
! +2>> !marker create  &
! +2>> !   marker_name = .CV_Joint.ground.ground_homokin1  &
! +2>> !   location = 0,0,0 &
! +2>> !   orientation = 0,0,0
! +2>> !
! +2>> !disp icon mar mar=.CV_Joint.ground.ground_homokin1 size=20
! +2>> !
! +2>> !marker create  &
